subscription_id      = "00000000-0000-0000-0000-000000000001"
backend_storage_name = "REPLACE_WITH_UNIQUE_NAME"

# Repository part of the real OIDC subject (see the "Inspect OIDC subject" workflow).
# The bootstrap derives ":ref:refs/heads/main" for plan and ":environment:<tenant>" for apply.
github_oidc_subject_prefix = "repo:OWNER@OWNER_ID/REPO@REPO_ID"

# Optional: defaults are wpc-2026-sales and wpc-2026-operations. Only dedicated wpc-* groups are accepted.
# tenants = {
#   sales      = { resource_group_name = "wpc-2026-sales" }
#   operations = { resource_group_name = "wpc-2026-operations" }
# }
